# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Service role key for server-side user upsert (falls back to anon key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI (Genkit) - required for AI card features
GOOGLE_GENAI_API_KEY=your-google-genai-api-key

# Local dev: simulate Cloudflare Access user email
# X-User-Email header is read as fallback when cf-access-authenticated-user-email is absent
